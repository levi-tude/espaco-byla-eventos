NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta dos webhooks (painel do app no Mercado Pago). Sem ela, os avisos são recusados.
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=ACDH Eventos <ingressos@seu-dominio.com>
# E-mail da equipe que recebe alertas de pagamento/ingresso com problema.
ALERT_EMAIL=
# E-mail público de contato para privacidade/LGPD e compras (aparece em /privacidade e /termos).
PRIVACY_CONTACT_EMAIL=
# Só no deploy: protege /api/cron/keep-alive (32+ caracteres; o mesmo valor fica no Vault
# da Supabase como keep_alive_cron_secret quando o agendamento sai da Vercel).
CRON_SECRET=
# Só no deploy: protege /api/cron/abandoned-reminders (o mesmo valor fica no Vault
# da Supabase como reminder_cron_secret). Sem ela, os lembretes nunca são enviados.
REMINDER_CRON_SECRET=

# Verificação anti-robô (Cloudflare Turnstile, grátis) no checkout e no pagamento.
# Em produção, sem as duas chaves, compras e pagamentos são RECUSADOS (falha fechada).
# Em desenvolvimento/teste, sem chaves, a verificação é pulada.
# A chave pública entra no build: depois de mudar, publique de novo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cabeçalho com o IP real do comprador (limite de tentativas). Um destes, conforme a hospedagem:
# x-real-ip (Vercel; Caddy/nginx configurados para enviá-lo) | x-nf-client-connection-ip (Netlify)
# cf-connecting-ip (atrás do proxy da Cloudflare) | x-forwarded-for-first | x-forwarded-for-last
# Vazio = x-real-ip.
TRUSTED_IP_HEADER=

# Só para build Docker (VPS/Cloud Run): servidor Node enxuto em .next/standalone.
# NEXT_OUTPUT_STANDALONE=true
# Mesma chave em todos os builds evita "Failed to find Server Action" ao trocar de versão
# (base64 de 32 bytes: openssl rand -base64 32). Opcional com uma única instância.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
