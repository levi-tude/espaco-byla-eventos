NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta dos webhooks (painel do app no Mercado Pago). Sem ela, os avisos são recusados.
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=Espaço Byla <ingressos@seu-dominio.com>
# E-mail da equipe que recebe alertas de pagamento/ingresso com problema.
ALERT_EMAIL=
# E-mail público de contato para privacidade/LGPD (aparece em /privacidade).
PRIVACY_CONTACT_EMAIL=
# Só no deploy (Vercel): protege /api/cron/keep-alive.
CRON_SECRET=
# Só no deploy (Vercel): protege /api/cron/abandoned-reminders (o mesmo valor fica no Vault
# da Supabase como reminder_cron_secret). Sem ela, os lembretes nunca são enviados.
REMINDER_CRON_SECRET=
